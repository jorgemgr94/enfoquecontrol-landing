---
import logo from "../assets/enfoque-logo.png";

const whatsappNumber = "5218118791398";
const whatsappBase = `https://wa.me/${whatsappNumber}`;

const contexts = [
	{
		title: "Quiero proteger mi hogar",
		text: "Casas y departamentos con una atención pensada para la rutina de quienes viven ahí.",
		message: "Hola, necesito orientación para control de plagas en mi hogar.",
		icon: "home",
	},
	{
		title: "Necesito cuidar mi negocio",
		text: "Comercios, oficinas y restaurantes donde la confianza y la continuidad importan.",
		message: "Hola, necesito orientación para control de plagas en mi negocio.",
		icon: "store",
	},
	{
		title: "Busco atención industrial",
		text: "Bodegas, plantas y áreas operativas que requieren seguimiento y prevención.",
		message: "Hola, necesito orientación para control de plagas en una instalación industrial.",
		icon: "industry",
	},
];

const signals = [
	{ value: "Cucarachas", label: "Cucarachas", note: "Cocina, baño o drenajes" },
	{ value: "Roedores", label: "Roedores", note: "Ruidos, huellas o daños" },
	{ value: "Termitas", label: "Termitas", note: "Madera o estructura" },
	{ value: "Mosquitos", label: "Mosquitos", note: "Patios y exteriores" },
	{ value: "Chinches", label: "Chinches", note: "Recámaras o muebles" },
	{ value: "No estoy seguro", label: "No estoy seguro", note: "Ayúdame a identificarlo" },
];

const faqs = [
	{
		question: "¿Puedo enviar fotografías por WhatsApp?",
		answer: "Sí. Las imágenes del área, rastros o daños observados pueden dar contexto a la primera conversación y ayudar a decidir qué información hace falta.",
	},
	{
		question: "¿Cómo se define el tratamiento?",
		answer: "Depende de la plaga, el nivel de actividad y las condiciones del inmueble. La recomendación se realiza después de entender esos factores.",
	},
	{
		question: "¿Necesito preparar el espacio?",
		answer: "Cada tratamiento tiene indicaciones distintas. Te explicaremos qué preparar y, cuando aplique, el tiempo de reingreso antes de la visita.",
	},
	{
		question: "¿Tienen cobertura en mi municipio?",
		answer: "La atención se concentra en Monterrey y su área metropolitana. Escríbenos con tu ubicación para confirmar disponibilidad.",
	},
];

const schema = {
	"@context": "https://schema.org",
	"@type": "PestControl",
	name: "Enfoque Pest Control",
	url: "https://www.enfoquecontrol.com",
	telephone: "+52 81 1879 1398",
	image: "https://www.enfoquecontrol.com/bg-image.webp",
	areaServed: "Monterrey Metropolitan Area",
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<header class="warm-header">
	<div class="header-shell">
		<a href="#inicio" class="brand" aria-label="Enfoque Pest Control, inicio">
			<img src={logo.src} alt="Enfoque Pest Control" width="462" height="221" />
		</a>
		<nav aria-label="Navegación principal">
			<a href="#soluciones">Soluciones</a>
			<a href="#como-ayudamos">Cómo ayudamos</a>
			<a href="#preguntas">Preguntas</a>
		</nav>
		<a
			class="header-action"
			href={`${whatsappBase}?text=${encodeURIComponent("Hola, necesito orientación para controlar una plaga.")}`}
			target="_blank"
			rel="noreferrer"
		>
			<i aria-hidden="true"></i>
			<strong>Cotizar por WhatsApp</strong>
		</a>
	</div>
</header>

<main id="contenido">
	<section class="hero" id="inicio">
		<div class="hero-shell">
			<div class="hero-copy">
				<div class="availability"><i></i> Atención en Monterrey y área metropolitana</div>
				<h1>Tu espacio,<br /><em>bajo control.</em></h1>
				<p>Atención para hogares, negocios e industria. Cuéntanos qué estás viendo y recibe una orientación clara para el siguiente paso.</p>
				<div class="hero-proof">
					<div class="proof-mark">
						<svg aria-hidden="true" viewBox="0 0 32 32"><path d="M16 3 27 8v8c0 7-4.7 11.5-11 13C9.7 27.5 5 23 5 16V8l11-5Z"/><path d="m11 16 3 3 7-7"/></svg>
					</div>
					<p><strong>Atención según tu contexto</strong><span>Hogar, comercio o industria.</span></p>
				</div>
			</div>

			<form class="hero-diagnostic" id="diagnosis-form">
				<div class="form-heading">
					<span>Orientación inicial</span>
					<h2>¿Qué estás viendo?</h2>
					<p>Elige la opción más cercana. Puedes explicar los detalles en WhatsApp.</p>
				</div>

				<fieldset>
					<legend class="sr-only">Plaga o señal observada</legend>
					<div class="signal-grid">
						{signals.map((signal) => (
							<label>
								<input type="checkbox" name="signals" value={signal.value} />
								<span class="radio-face">
									<i aria-hidden="true"></i>
									<strong>{signal.label}</strong>
									<small>{signal.note}</small>
								</span>
							</label>
						))}
					</div>
				</fieldset>

				<div class="form-row">
					<div class="select-field">
						<label for="diagnosis-space">¿Dónde ocurre?</label>
						<select id="diagnosis-space" name="space" required>
							<option value="">Elige el espacio</option>
							<option>Casa o departamento</option>
							<option>Negocio o comercio</option>
							<option>Oficina</option>
							<option>Restaurante</option>
							<option>Bodega o industria</option>
							<option>Otro espacio</option>
						</select>
					</div>
					<button type="submit">
						Continuar en WhatsApp
						<span aria-hidden="true">↗</span>
					</button>
				</div>
				<p class="privacy">No almacenamos tus respuestas en este sitio.</p>
			</form>
		</div>
	</section>

	<section class="context-section" id="soluciones">
		<div class="section-heading">
			<span class="pill">Soluciones</span>
			<h2>El mismo problema puede necesitar enfoques distintos.</h2>
			<p>La atención cambia según el lugar, su operación y las personas que lo utilizan.</p>
		</div>
		<div class="context-grid">
			{contexts.map((context) => (
				<article>
					<div class="context-icon">
						{context.icon === "home" && <svg aria-hidden="true" viewBox="0 0 36 36"><path d="m5 17 13-11 13 11v13H5V17Z"/><path d="M14 30V20h8v10"/></svg>}
						{context.icon === "store" && <svg aria-hidden="true" viewBox="0 0 36 36"><path d="M6 15v15h24V15M4 14l3-8h22l3 8"/><path d="M4 14c0 3 5 3 5 0 0 3 5 3 5 0 0 3 5 3 5 0 0 3 5 3 5 0 0 3 5 3 5 0 0 3 5 3 5 0"/></svg>}
						{context.icon === "industry" && <svg aria-hidden="true" viewBox="0 0 36 36"><path d="M5 30V15l9 5v-8l9 5V6h8v24H5Z"/><path d="M10 25h3m5 0h3m5 0h2"/></svg>}
					</div>
					<h3>{context.title}</h3>
					<p>{context.text}</p>
					<a href={`${whatsappBase}?text=${encodeURIComponent(context.message)}`} target="_blank" rel="noreferrer">
						Contar mi caso <span aria-hidden="true">↗</span>
					</a>
				</article>
			))}
		</div>
	</section>

	<section class="photo-story">
		<div class="photo-shell">
			<div class="photo-wrap">
				<img src="/bg-image.webp" alt="Técnico realizando una inspección profesional en una vivienda" width="1920" height="1282" loading="lazy" />
				<div class="photo-badge">
					<span class="badge-dot"></span>
					Diagnóstico antes de recomendar
				</div>
			</div>
			<div class="story-copy">
				<span class="pill pill-light">Nuestro enfoque</span>
				<h2>Primero entendemos. Después actuamos.</h2>
				<p>Las señales visibles son solo una parte del problema. El tipo de espacio, los puntos de acceso y la actividad observada ayudan a definir una atención adecuada.</p>
				<ul>
					<li><i>Escuchar</i><span>Qué observaste y desde cuándo.</span></li>
					<li><i>Revisar</i><span>El espacio y las condiciones del caso.</span></li>
					<li><i>Resolver</i><span>Con tratamiento e indicaciones claras.</span></li>
					<li><i>Prevenir</i><span>Reduciendo condiciones de reaparición.</span></li>
				</ul>
			</div>
		</div>
	</section>

	<section class="conversation" id="como-ayudamos">
		<div class="conversation-copy">
			<span class="pill">Una conversación basta para empezar</span>
			<h2>Pregunta. Contexto. Siguiente paso.</h2>
			<p>Este es el tipo de información que nos ayuda a orientarte mejor desde el primer mensaje.</p>
		</div>
		<div class="chat-card">
			<div class="chat-top">
				<img src={logo.src} alt="" aria-hidden="true" width="462" height="221" loading="lazy" />
				<div><strong>Enfoque Pest Control</strong><span>Orientación por WhatsApp</span></div>
				<i></i>
			</div>
			<div class="messages">
				<div class="message incoming">Hola, ¿qué problema estás observando?</div>
				<div class="message outgoing">He visto cucarachas cerca de la cocina.</div>
				<div class="message incoming">¿Es una casa, negocio u otro tipo de espacio?</div>
				<div class="message outgoing">Una casa en Monterrey.</div>
			</div>
			<a href={`${whatsappBase}?text=${encodeURIComponent("Hola, necesito orientación para controlar una plaga.")}`} target="_blank" rel="noreferrer">
				Empezar mi conversación
				<span aria-hidden="true">↗</span>
			</a>
		</div>
	</section>

	<section class="faq-section" id="preguntas">
		<div class="faq-heading">
			<span class="pill">Antes de agendar</span>
			<h2>Preguntas comunes, respuestas claras.</h2>
		</div>
		<div class="faq-list">
			{faqs.map((faq) => (
				<details>
					<summary><span>{faq.question}</span><i aria-hidden="true"></i></summary>
					<p>{faq.answer}</p>
				</details>
			))}
		</div>
	</section>

	<section class="coverage">
		<div class="coverage-shell">
			<div class="coverage-copy">
				<span class="pill pill-light">Cobertura metropolitana</span>
				<h2>¿Estás en Monterrey o sus alrededores?</h2>
				<p>Comparte tu municipio por WhatsApp y confirma la disponibilidad para tu zona.</p>
			</div>
			<a href={`${whatsappBase}?text=${encodeURIComponent("Hola, quiero confirmar si tienen cobertura en mi municipio.")}`} target="_blank" rel="noreferrer">
				Confirmar cobertura
				<span aria-hidden="true">↗</span>
			</a>
		</div>
	</section>
</main>

<footer>
	<div class="footer-shell">
		<div class="footer-brand">
			<img src={logo.src} alt="Enfoque Pest Control" width="462" height="221" loading="lazy" />
			<p>Control profesional de plagas para hogares, negocios e industria.</p>
		</div>
		<div class="footer-action">
			<span>Contacto directo</span>
			<a href="tel:+528118791398">81 1879 1398</a>
			<a href={`${whatsappBase}?text=${encodeURIComponent("Hola, necesito información.")}`} target="_blank" rel="noreferrer">WhatsApp ↗</a>
		</div>
	</div>
	<div class="footer-bottom"><span>© {new Date().getFullYear()} Enfoque Pest Control</span><span>Monterrey, Nuevo León</span></div>
</footer>

<a class="floating-chat" href={`${whatsappBase}?text=${encodeURIComponent("Hola, necesito orientación para controlar una plaga.")}`} target="_blank" rel="noreferrer" aria-label="Abrir WhatsApp">
	<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20.5 3.5A11.8 11.8 0 0 0 12.08 0C5.52 0 .2 5.3.2 11.84c0 2.09.55 4.13 1.58 5.93L.1 23.9l6.28-1.64a11.9 11.9 0 0 0 5.69 1.45h.01c6.55 0 11.88-5.31 11.88-11.85 0-3.17-1.23-6.14-3.46-8.37Zm-8.42 18.21h-.01a9.88 9.88 0 0 1-5.04-1.38l-.36-.21-3.73.98 1-3.63-.24-.37a9.82 9.82 0 0 1-1.51-5.25c0-5.43 4.44-9.85 9.9-9.85a9.8 9.8 0 0 1 7 2.9 9.77 9.77 0 0 1 2.9 6.97c0 5.43-4.45 9.84-9.91 9.84Z"/></svg>
	<span>Cuéntanos qué ves</span>
</a>

<script>
	const form = document.querySelector<HTMLFormElement>("#diagnosis-form");
	const signalInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="signals"]'));

	signalInputs.forEach((input) => {
		input.addEventListener("change", () => {
			signalInputs[0]?.setCustomValidity("");
		});
	});

	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		const data = new FormData(form);
		const selectedSignals = data.getAll("signals");

		if (selectedSignals.length === 0) {
			signalInputs[0]?.setCustomValidity("Selecciona al menos una opción.");
			signalInputs[0]?.reportValidity();
			return;
		}

		signalInputs[0]?.setCustomValidity("");
		const message = `Hola, necesito orientación para control de plagas.\n\nEstoy viendo: ${selectedSignals.join(", ")}\nOcurre en: ${data.get("space")}`;
		window.open(`https://wa.me/5218118791398?text=${encodeURIComponent(message)}`, "_blank", "noopener,noreferrer");
	});
</script>

<style>
	:global(body) {
		background: #f6f0e4;
		color: #163326;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.warm-header {
		background: #fbf7ee;
	}

	.header-shell,
	.hero-shell,
	.context-section,
	.photo-shell,
	.conversation,
	.faq-section,
	.coverage-shell,
	.footer-shell,
	.footer-bottom {
		width: min(1180px, calc(100% - 48px));
		margin: 0 auto;
	}

	.header-shell {
		min-height: 104px;
		display: grid;
		grid-template-columns: 200px 1fr auto;
		align-items: center;
		gap: 40px;
	}

	.brand {
		width: 184px;
		display: inline-flex;
	}

	.brand img,
	.footer-brand img {
		display: block;
		width: 100%;
		height: auto;
	}

	nav {
		display: flex;
		justify-content: center;
		gap: 30px;
	}

	nav a {
		color: #607168;
		font-size: .78rem;
		font-weight: 650;
		text-decoration: none;
		transition: color 160ms cubic-bezier(.23, 1, .32, 1);
	}

	nav a:hover {
		color: #267047;
	}

	.header-action {
		min-height: 48px;
		padding: 0 17px;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		border: 1px solid rgba(22, 51, 38, .18);
		border-radius: 9px;
		text-decoration: none;
		transition: border-color 160ms cubic-bezier(.23, 1, .32, 1), background 160ms cubic-bezier(.23, 1, .32, 1), transform 120ms;
	}

	.header-action:hover {
		border-color: #4d8557;
		background: rgba(65, 125, 75, .05);
	}

	.header-action:active {
		transform: scale(.97);
	}

	.header-action i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #83a93d;
		box-shadow: 0 0 0 4px rgba(131, 169, 61, .1);
	}

	.header-action strong {
		color: #163326;
		font-size: .74rem;
	}

	.hero {
		position: relative;
		overflow: hidden;
		background: #fbf7ee;
	}

	.hero::before,
	.hero::after {
		content: "";
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
	}

	.hero::before {
		top: -220px;
		right: -180px;
		width: 620px;
		height: 620px;
		border: 1px solid rgba(67, 132, 74, .12);
		box-shadow: 0 0 0 70px rgba(67, 132, 74, .025), 0 0 0 140px rgba(67, 132, 74, .018);
	}

	.hero::after {
		bottom: -130px;
		left: -130px;
		width: 260px;
		height: 260px;
		background: rgba(181, 207, 94, .15);
	}

	.hero-shell {
		position: relative;
		z-index: 1;
		min-height: 760px;
		padding: 76px 0 96px;
		display: grid;
		grid-template-columns: .78fr 1.22fr;
		align-items: center;
		gap: clamp(56px, 8vw, 110px);
	}

	.availability {
		display: flex;
		align-items: center;
		gap: 10px;
		color: #527160;
		font-size: .68rem;
		font-weight: 750;
	}

	.availability i {
		width: 9px;
		height: 9px;
		border: 2px solid #fbf7ee;
		border-radius: 50%;
		background: #83a93d;
		box-shadow: 0 0 0 1px #83a93d, 0 0 0 5px rgba(131, 169, 61, .1);
	}

	h1,
	h2,
	h3,
	p {
		text-wrap: pretty;
	}

	h1,
	h2 {
		text-wrap: balance;
	}

	h1 {
		max-width: 660px;
		margin: 30px 0 24px;
		font-size: clamp(4rem, 6.8vw, 6.7rem);
		font-weight: 590;
		letter-spacing: -.075em;
		line-height: .9;
	}

	h1 em {
		color: #3e7a4a;
		font-family: Georgia, "Times New Roman", serif;
		font-weight: 400;
	}

	.hero-copy > p {
		max-width: 510px;
		margin: 0;
		color: #6b7a71;
		font-size: 1rem;
		line-height: 1.7;
	}

	.hero-proof {
		margin-top: 38px;
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.proof-mark {
		width: 46px;
		height: 46px;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: #e4ead8;
	}

	.proof-mark svg {
		width: 23px;
		height: 23px;
		fill: none;
		stroke: #3b7446;
		stroke-width: 1.5;
	}

	.hero-proof p,
	.hero-proof strong,
	.hero-proof span {
		display: block;
		margin: 0;
	}

	.hero-proof strong {
		font-size: .78rem;
	}

	.hero-proof span {
		margin-top: 3px;
		color: #7b8980;
		font-size: .68rem;
	}

	.hero-diagnostic {
		padding: clamp(26px, 4vw, 48px);
		border-radius: 28px;
		background: #17392a;
		box-shadow: 0 30px 80px rgba(30, 54, 41, .16);
		color: #fff;
	}

	.form-heading > span {
		color: #b8d56c;
		font-size: .65rem;
		font-weight: 800;
		letter-spacing: .1em;
		text-transform: uppercase;
	}

	.form-heading h2 {
		margin: 14px 0 10px;
		font-size: clamp(2rem, 3vw, 2.85rem);
		font-weight: 580;
		letter-spacing: -.05em;
		white-space: nowrap;
	}

	.form-heading p {
		margin: 0;
		color: rgba(255, 255, 255, .55);
		font-size: .76rem;
	}

	.hero-diagnostic fieldset {
		margin: 28px 0 0;
		padding: 0;
		border: 0;
	}

	.signal-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 9px;
	}

	.signal-grid label {
		position: relative;
		cursor: pointer;
	}

	.signal-grid input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.radio-face {
		min-height: 78px;
		padding: 13px 14px 13px 42px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		border: 1px solid rgba(255, 255, 255, .13);
		border-radius: 10px;
		background: rgba(255, 255, 255, .045);
		transition: border-color 160ms cubic-bezier(.23, 1, .32, 1), background 160ms cubic-bezier(.23, 1, .32, 1), transform 120ms;
	}

	.radio-face > i {
		position: absolute;
		top: 50%;
		left: 15px;
		width: 15px;
		height: 15px;
		border: 1px solid rgba(255, 255, 255, .4);
		border-radius: 50%;
		transform: translateY(-50%);
	}

	.radio-face strong {
		font-size: .76rem;
	}

	.radio-face small {
		margin-top: 3px;
		color: rgba(255, 255, 255, .43);
		font-size: .62rem;
	}

	.signal-grid label:hover .radio-face {
		border-color: rgba(184, 213, 108, .5);
		background: rgba(255, 255, 255, .07);
	}

	.signal-grid input:focus-visible + .radio-face {
		outline: 3px solid #9fbd57;
		outline-offset: 2px;
	}

	.signal-grid input:checked + .radio-face {
		border-color: #b8d56c;
		background: #254d39;
	}

	.signal-grid input:checked + .radio-face > i {
		border-color: #b8d56c;
		box-shadow: inset 0 0 0 3px #254d39;
		background: #b8d56c;
	}

	.form-row {
		margin-top: 18px;
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: end;
		gap: 10px;
	}

	.select-field label {
		display: block;
		margin-bottom: 8px;
		color: rgba(255, 255, 255, .65);
		font-size: .67rem;
		font-weight: 700;
	}

	.select-field select {
		width: 100%;
		height: 52px;
		padding: 0 13px;
		border: 1px solid rgba(255, 255, 255, .13);
		border-radius: 9px;
		outline: 0;
