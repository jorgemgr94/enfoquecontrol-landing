---
import logo from '../assets/enfoque-logo.png';
import heroInspection from '../assets/hero-field-inspection.webp';
import homeInspection from '../assets/visual-storytelling/home-inspection.webp';
import businessInspection from '../assets/visual-storytelling/business-inspection.webp';
import industrialInspection from '../assets/visual-storytelling/industrial-inspection.webp';
import ExternalArrowIcon from './icons/ExternalArrowIcon.astro';

const whatsappNumber = '5218118791398';
const whatsappBase = `https://wa.me/${whatsappNumber}`;

const contexts = [
	{
		title: 'Quiero proteger mi hogar',
		text: 'Casas y departamentos con una atención pensada para la rutina de quienes viven ahí.',
		message: 'Hola, necesito orientación para control de plagas en mi hogar.',
		image: homeInspection,
		imageAlt: 'Técnico inspeccionando los accesos de una cocina residencial',
		label: 'Espacios habitados'
	},
	{
		title: 'Necesito cuidar mi negocio',
		text: 'Comercios, oficinas y restaurantes donde la confianza y la continuidad importan.',
		message: 'Hola, necesito orientación para control de plagas en mi negocio.',
		image: businessInspection,
		imageAlt: 'Técnico realizando una inspección preventiva en un restaurante',
		label: 'Operación continua'
	},
	{
		title: 'Busco atención industrial',
		text: 'Bodegas, plantas y áreas operativas que requieren seguimiento y prevención.',
		message: 'Hola, necesito orientación para control de plagas en una instalación industrial.',
		image: industrialInspection,
		imageAlt: 'Técnico revisando el perímetro interior de una bodega',
		label: 'Prevención operativa'
	}
];

const signals = [
	{ value: 'Cucarachas', label: 'Cucarachas', note: 'Cocina, baño o drenajes' },
	{ value: 'Roedores', label: 'Roedores', note: 'Ruidos, huellas o daños' },
	{ value: 'Termitas', label: 'Termitas', note: 'Madera o estructura' },
	{ value: 'Mosquitos', label: 'Mosquitos', note: 'Patios y exteriores' },
	{ value: 'Chinches', label: 'Chinches', note: 'Recámaras o muebles' },
	{ value: 'No estoy seguro', label: 'No estoy seguro', note: 'Ayúdame a identificarlo' }
];

const coverage = [
	'Monterrey',
	'San Nicolás',
	'Guadalupe',
	'Apodaca',
	'Escobedo',
	'Santa Catarina',
	'San Pedro',
	'Área metropolitana'
];

const faqs = [
	{
		question: '¿Puedo enviar fotografías?',
		answer:
			'Sí. Las imágenes del área, rastros o daños observados pueden dar contexto a la primera conversación y ayudar a decidir qué información hace falta.'
	},
	{
		question: '¿Cómo se define el tratamiento?',
		answer:
			'Depende de la plaga, el nivel de actividad y las condiciones del inmueble. La recomendación se realiza después de entender esos factores.'
	},
	{
		question: '¿Necesito preparar el espacio?',
		answer:
			'Cada tratamiento tiene indicaciones distintas. Te explicaremos qué preparar y, cuando aplique, el tiempo de reingreso antes de la visita.'
	},
	{
		question: '¿Tienen cobertura en mi municipio?',
		answer:
			'La atención se concentra en Monterrey y su área metropolitana. Escríbenos con tu ubicación para confirmar disponibilidad.'
	}
];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'PestControl',
	name: 'Enfoque Pest Control',
	url: 'https://www.enfoquecontrol.com',
	telephone: '+52 81 1879 1398',
	image: 'https://www.enfoquecontrol.com/bg-image.webp',
	areaServed: 'Monterrey Metropolitan Area'
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

<header class="warm-header">
	<div class="header-shell">
		<a href="#inicio" class="brand" aria-label="Enfoque Pest Control, inicio">
			<img src={logo.src} alt="Enfoque Pest Control" width="462" height="221" />
		</a>
		<nav aria-label="Navegación principal">
			<a href="#soluciones">Soluciones</a>
			<a href="#proceso">Proceso</a>
			<a href="#cobertura">Cobertura</a>
			<a href="#preguntas">Preguntas</a>
		</nav>
		<a
			class="header-action"
			href={`${whatsappBase}?text=${encodeURIComponent('Hola, necesito orientación para controlar una plaga.')}`}
			target="_blank"
			rel="noreferrer"
		>
			<i aria-hidden="true"></i>
			<strong>Cotizar por WhatsApp</strong>
			<ExternalArrowIcon class="header-action-icon" />
		</a>
	</div>
</header>

<main id="contenido">
	<section class="hero" id="inicio">
		<div class="hero-shell">
			<div class="hero-copy">
				<div class="availability"><i></i> Atención en Monterrey y área metropolitana</div>
				<h1>Tu espacio,<br /><em>bajo control.</em></h1>
				<p>
					Atención para hogares, negocios e industria. Cuéntanos qué estás viendo y recibe una
					orientación clara para el siguiente paso.
				</p>
			</div>

			<div class="hero-stage">
				<figure class="hero-visual">
					<img
						src={heroInspection.src}
						alt="Técnico inspeccionando un perímetro con lámpara y espejo de revisión"
						width={heroInspection.width}
						height={heroInspection.height}
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption><i aria-hidden="true"></i> Diagnóstico antes de intervenir</figcaption>
				</figure>

				<form class="hero-diagnostic" id="diagnosis-form">
					<div class="form-heading">
						<span>Orientación inicial</span>
						<h2>¿Qué estás viendo?</h2>
						<p>Selecciona una o varias opciones. Puedes explicar los detalles al continuar.</p>
					</div>

					<fieldset>
						<legend class="sr-only">Plaga o señal observada</legend>
						<div class="signal-grid">
							{
								signals.map((signal) => (
									<label>
										<input type="checkbox" name="signals" value={signal.value} />
										<span class="signal-face">
											<i aria-hidden="true" />
											<strong>{signal.label}</strong>
											<small>{signal.note}</small>
										</span>
									</label>
								))
							}
						</div>
					</fieldset>

					<div class="form-row">
						<div class="select-field">
							<label for="diagnosis-space">¿Dónde ocurre?</label>
							<select id="diagnosis-space" name="space" required>
								<option value="">Elige el espacio</option>
								<option>Casa o departamento</option>
								<option>Negocio o comercio</option>
								<option>Oficina</option>
								<option>Restaurante</option>
								<option>Bodega o industria</option>
								<option>Otro espacio</option>
							</select>
						</div>
						<button type="submit">
							Solicitar diagnóstico
							<ExternalArrowIcon />
						</button>
					</div>
				</form>
			</div>
		</div>
	</section>

	<section class="trust-section" aria-labelledby="trust-title">
		<div class="trust-shell">
			<div class="trust-intro">
				<span>Experiencia de campo</span>
				<h2 id="trust-title">Atención con criterio, no soluciones improvisadas.</h2>
			</div>
			<ul class="trust-points">
				<li>
					<strong>Experiencia previa</strong>
					<span>En control de plagas para hogares, negocios e industria.</span>
				</li>
				<li>
					<strong>Atención directa</strong>
					<span>El caso se revisa antes de recomendar un tratamiento.</span>
				</li>
				<li>
					<strong>Indicaciones claras</strong>
					<span>Qué preparar, qué esperar y cuándo volver a utilizar el espacio.</span>
				</li>
				<li>
					<strong>Seguimiento</strong>
					<span>Definido de acuerdo con la plaga y el tratamiento aplicado.</span>
				</li>
			</ul>
		</div>
	</section>

	<section class="context-section" id="soluciones">
		<div class="section-heading">
			<span class="pill">Servicios</span>
			<h2>El mismo problema puede necesitar enfoques distintos.</h2>
			<p>La atención cambia según el lugar, su operación y las personas que lo utilizan.</p>
		</div>
		<div class="context-grid">
			{
				contexts.map((context) => (
					<article>
						<figure class="context-visual">
							<img
								src={context.image.src}
								alt={context.imageAlt}
								width={context.image.width}
								height={context.image.height}
								loading="lazy"
								decoding="async"
							/>
							<figcaption>{context.label}</figcaption>
						</figure>
						<div class="context-body">
							<div>
								<h3>{context.title}</h3>
								<p>{context.text}</p>
							</div>
							<a
								href={`${whatsappBase}?text=${encodeURIComponent(context.message)}`}
								target="_blank"
								rel="noreferrer"
							>
								Solicitar diagnóstico <ExternalArrowIcon />
							</a>
						</div>
					</article>
				))
			}
		</div>
	</section>

	<section class="photo-story" id="proceso">
		<div class="photo-shell">
			<div class="story-top">
				<div class="photo-wrap">
					<img
						src="/bg-image.webp"
						alt="Técnico realizando una inspección profesional en una vivienda"
						width="1920"
						height="1282"
						loading="lazy"
					/>
					<div class="photo-badge">
						<span class="badge-dot"></span>
						Diagnóstico antes de recomendar
					</div>
				</div>
				<div class="story-copy">
					<span class="pill pill-light">Nuestro enfoque</span>
					<h2>Primero entendemos. Después actuamos.</h2>
					<p>
						Las señales visibles son solo una parte del problema. El tipo de espacio, los puntos de
						acceso y la actividad observada ayudan a definir una atención adecuada.
					</p>
				</div>
			</div>

			<div class="process-timeline" aria-label="Nuestro proceso de atención">
				<article>
					<i class="timeline-node" aria-hidden="true"></i>
					<strong>Escuchar</strong>
					<p>Qué observaste y desde cuándo.</p>
				</article>
				<article>
					<i class="timeline-node" aria-hidden="true"></i>
					<strong>Revisar</strong>
					<p>El espacio y las condiciones del caso.</p>
				</article>
				<article>
					<i class="timeline-node" aria-hidden="true"></i>
					<strong>Resolver</strong>
					<p>Con tratamiento e indicaciones claras.</p>
				</article>
				<article>
					<i class="timeline-node" aria-hidden="true"></i>
					<strong>Prevenir</strong>
					<p>Reduciendo condiciones de reaparición.</p>
				</article>
			</div>
		</div>
	</section>

	<section class="conversation">
		<div class="conversation-copy">
			<span class="pill">Una conversación basta para empezar</span>
			<h2>Pregunta. Contexto. Siguiente paso.</h2>
			<p>
				Este es el tipo de información que nos ayuda a orientarte mejor desde el primer mensaje.
			</p>
		</div>
		<div class="chat-card">
			<div class="chat-top">
				<img src={logo.src} alt="" aria-hidden="true" width="462" height="221" loading="lazy" />
				<div><strong>Enfoque Pest Control</strong><span>Orientación</span></div>
				<i></i>
			</div>
			<div class="messages">
				<div class="message incoming">Hola, ¿qué problema estás observando?</div>
				<div class="message outgoing">He visto cucarachas cerca de la cocina.</div>
				<div class="message incoming">¿Es una casa, negocio u otro tipo de espacio?</div>
				<div class="message outgoing">Una casa en Monterrey.</div>
			</div>
			<a
				href={`${whatsappBase}?text=${encodeURIComponent('Hola, necesito orientación para controlar una plaga.')}`}
				target="_blank"
				rel="noreferrer"
			>
				Cotizar por WhatsApp
				<ExternalArrowIcon />
			</a>
		</div>
	</section>

	<section class="coverage-section" id="cobertura">
		<div class="coverage-copy">
			<p class="coverage-kicker">Cobertura</p>
			<h2>Cerca cuando importa.</h2>
			<p>
				Atención en Monterrey y municipios del área metropolitana. Confirma disponibilidad para tu
				ubicación al solicitar información.
			</p>
			<a
				class="coverage-link"
				href={`${whatsappBase}?text=${encodeURIComponent('Hola, quiero confirmar si tienen cobertura en mi municipio.')}`}
				target="_blank"
				rel="noreferrer"
			>
				Consultar disponibilidad <ExternalArrowIcon />
			</a>
		</div>
		<div class="coverage-map" aria-label="Municipios atendidos">
			<div class="map-rings" aria-hidden="true">
				<span></span><span></span><span></span>
				<i></i>
			</div>
			<ul>
				{coverage.map((city) => <li>{city}</li>)}
			</ul>
		</div>
	</section>

	<section class="faq-section" id="preguntas">
		<div class="faq-heading">
			<span class="pill">Antes de agendar</span>
			<h2>Preguntas comunes, respuestas claras.</h2>
		</div>
		<div class="faq-list">
			{
				faqs.map((faq) => (
					<details>
						<summary>
							<>
								<span>{faq.question}</span>
								<i aria-hidden="true" />
							</>
						</summary>
						<p>{faq.answer}</p>
					</details>
				))
			}
		</div>
	</section>
</main>

<footer>
	<div class="footer-shell">
		<div class="footer-brand">
			<img src={logo.src} alt="Enfoque Pest Control" width="462" height="221" loading="lazy" />
			<p>Control profesional de plagas para hogares, negocios e industria.</p>
		</div>
		<div class="footer-action">
			<span>Contacto directo</span>
			<a href="tel:+528118791398">81 1879 1398</a>
			<a
				class="footer-contact-link"
				href={`${whatsappBase}?text=${encodeURIComponent('Hola, necesito información.')}`}
				target="_blank"
				rel="noreferrer"
			>
				Cotizar por WhatsApp <ExternalArrowIcon />
			</a>
		</div>
	</div>
	<div class="footer-bottom">
		<span>© {new Date().getFullYear()} Enfoque Pest Control</span><span>Monterrey, Nuevo León</span>
	</div>
</footer>

<a
	class="floating-chat"
	href={`${whatsappBase}?text=${encodeURIComponent('Hola, quiero enviar fotos de la plaga para recibir orientación.')}`}
	target="_blank"
	rel="noreferrer"
	aria-label="Enviar fotos de la plaga por WhatsApp"
>
	<svg aria-hidden="true" viewBox="0 0 24 24"
		><path
			d="M20.5 3.5A11.8 11.8 0 0 0 12.08 0C5.52 0 .2 5.3.2 11.84c0 2.09.55 4.13 1.58 5.93L.1 23.9l6.28-1.64a11.9 11.9 0 0 0 5.69 1.45h.01c6.55 0 11.88-5.31 11.88-11.85 0-3.17-1.23-6.14-3.46-8.37Zm-8.42 18.21h-.01a9.88 9.88 0 0 1-5.04-1.38l-.36-.21-3.73.98 1-3.63-.24-.37a9.82 9.82 0 0 1-1.51-5.25c0-5.43 4.44-9.85 9.9-9.85a9.8 9.8 0 0 1 7 2.9 9.77 9.77 0 0 1 2.9 6.97c0 5.43-4.45 9.84-9.91 9.84Z"
		></path></svg
	>
	<span>Enviar fotos de la plaga</span>
</a>

<script>
	const form = document.querySelector<HTMLFormElement>('#diagnosis-form');
	const signalInputs = Array.from(
		document.querySelectorAll<HTMLInputElement>('input[name="signals"]')
	);

	signalInputs.forEach((input) => {
		input.addEventListener('change', () => {
			signalInputs[0]?.setCustomValidity('');
		});
	});

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		const data = new FormData(form);
		const selectedSignals = data.getAll('signals');

		if (selectedSignals.length === 0) {
			signalInputs[0]?.setCustomValidity('Selecciona al menos una opción.');
			signalInputs[0]?.reportValidity();
			return;
		}

		signalInputs[0]?.setCustomValidity('');
		const message = `Hola, necesito orientación para control de plagas.\n\nEstoy viendo: ${selectedSignals.join(', ')}\nOcurre en: ${data.get('space')}`;
		window.open(
			`https://wa.me/5218118791398?text=${encodeURIComponent(message)}`,
			'_blank',
			'noopener,noreferrer'
		);
	});

	const floatingChat = document.querySelector<HTMLElement>('.floating-chat');
	const hero = document.querySelector<HTMLElement>('.hero');
	const floatingChatBlockers = Array.from(
		document.querySelectorAll<HTMLElement>(
			'a[href^="https://wa.me/"]:not(.floating-chat), .context-grid article, .chat-card, .coverage-section, .faq-section, footer'
		)
	);
	const visibleFloatingChatBlockers = new Set<Element>();
	let heroIsVisible = true;

	const updateFloatingChat = () => {
		floatingChat?.classList.toggle(
			'is-visible',
			!heroIsVisible && visibleFloatingChatBlockers.size === 0
		);
	};

	if ('IntersectionObserver' in window && hero) {
		const heroObserver = new IntersectionObserver(
			([entry]) => {
				heroIsVisible = entry.isIntersecting;
				updateFloatingChat();
			},
			{ threshold: 0.05 }
		);

		const floatingChatObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						visibleFloatingChatBlockers.add(entry.target);
					} else {
						visibleFloatingChatBlockers.delete(entry.target);
					}
				});
				updateFloatingChat();
			},
			{ threshold: 0.1 }
		);

		heroObserver.observe(hero);
		floatingChatBlockers.forEach((blocker) => floatingChatObserver.observe(blocker));
	}

	const revealItems = Array.from(
		document.querySelectorAll<HTMLElement>(
			'.trust-shell, .section-heading, .context-grid article, .story-top, .process-timeline, .conversation > *, .coverage-section > *, .faq-section > *'
		)
	);

	if ('IntersectionObserver' in window) {
		revealItems.forEach((item) => item.classList.add('reveal-item'));

		const revealObserver = new IntersectionObserver(
			(entries, observer) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add('is-revealed');
					observer.unobserve(entry.target);
				});
			},
			{ rootMargin: '0px 0px -10% 0px', threshold: 0.08 }
		);

		revealItems.forEach((item) => revealObserver.observe(item));
	}
</script>

<style>
	:global(body) {
		background: #f6f0e4;
		color: #163326;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.warm-header {
		background: #fbf7ee;
	}

	.header-shell,
	.hero-shell,
	.context-section,
	.photo-shell,
	.conversation,
	.faq-section,
	.coverage-section,
	.footer-shell,
	.footer-bottom {
		width: min(1180px, calc(100% - 48px));
		margin: 0 auto;
	}

	.header-shell {
		min-height: 104px;
		display: grid;
		grid-template-columns: 200px 1fr auto;
		align-items: center;
		gap: 40px;
	}

	.brand {
		width: 184px;
		display: inline-flex;
	}

	.brand img,
	.footer-brand img {
		display: block;
		width: 100%;
		height: auto;
	}

	nav {
		display: flex;
		justify-content: center;
		gap: 30px;
	}

	nav a {
		color: #607168;
		font-size: 0.78rem;
		font-weight: 650;
		text-decoration: none;
		transition: color 160ms cubic-bezier(0.23, 1, 0.32, 1);
	}

	nav a:hover {
		color: #267047;
	}

	.header-action {
		min-height: 48px;
		padding: 0 17px;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		border: 1px solid rgba(22, 51, 38, 0.18);
		border-radius: 9px;
		text-decoration: none;
		transition:
			border-color 160ms cubic-bezier(0.23, 1, 0.32, 1),
			background 160ms cubic-bezier(0.23, 1, 0.32, 1),
			transform 120ms;
	}

	.header-action:hover {
		border-color: #4d8557;
		background: rgba(65, 125, 75, 0.05);
	}

	.header-action:active {
		transform: scale(0.97);
	}

	.header-action i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #83a93d;
		box-shadow: 0 0 0 4px rgba(131, 169, 61, 0.1);
	}

	.header-action strong {
		color: #163326;
		font-size: 0.74rem;
		white-space: nowrap;
	}

	.header-action :global(.header-action-icon) {
		display: none;
		width: 19px;
		height: 19px;
	}

	.hero {
		position: relative;
		overflow: hidden;
		background: #fbf7ee;
	}

	.hero::before,
	.hero::after {
		content: '';
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
	}

	.hero::before {
		top: -220px;
		right: -180px;
		width: 620px;
		height: 620px;
		border: 1px solid rgba(67, 132, 74, 0.12);
		box-shadow:
			0 0 0 70px rgba(67, 132, 74, 0.025),
			0 0 0 140px rgba(67, 132, 74, 0.018);
	}

	.hero::after {
		bottom: -130px;
		left: -130px;
		width: 260px;
		height: 260px;
		background: rgba(181, 207, 94, 0.15);
	}

	.hero-shell {
		position: relative;
		z-index: 1;
		min-height: calc(100vh - 104px);
		min-height: calc(100svh - 104px);
		padding: clamp(32px, 5vh, 52px) 0;
